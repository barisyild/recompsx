! One vertex of RTPS/RTPT at sf = 1 with the depth cue (the last vertex), the common case of
! Gte.project, scheduled by scripts/dc-sched.py for the SH-4's pairing and latencies (the cache model's rules).
!   in   r4 = the vertex's VXY word in the register file (VZ is the next word)
!        r5 = bit 0 lm (lm = 1 is declined: the C path runs it)
!        r6 = the register file's base (recompsx_gte)
!   out  r0 = 0: done, every output written; 1: declined (MAC1-3 and IR1-3 perhaps written, which
!        the C path writes again; nothing else changed)
! A depth behind the camera, a divide that overflows or a quotient above 16 bits finish on the wide
! path (.Lwide): SX2/SY2 and MAC0 in 64 bits with their flags, as Gte.screenWide and depthCueWide.
!   uses r0-r7, MACH/MACL, T; r8-r11 saved and restored
! Words: TRX 9 TRY 10 TRZ 11 OFX 12 OFY 13 H 14 FLAG 15 SZ3 16 MAC1-3 17-19 IR1-3 20-22 SXY0-2 23-25
! SZ0-2 26-28 MAC0 29 IR0 30 DQA 31 DQB 32 SXY_WIDE 73 TR_WIDE 74 | UNR 128 RTP 648.
	.pushsection .text.recompsx_gte_rtp1,"ax",@progbits
	.align	5
.Lwneg0:
	! MAC3 negative: SZ3 0 with F_SZ3, and the divide overflows (F_DIVIDE)
	mov	#0,r2
	mov	#6,r3
	bra	.Lwpush
	shll16	r3
.Lwdiv0:
	! twice SZ3 not above H: the divide overflows (F_DIVIDE)
	mov	r10,r2
	mov	#2,r3
	bra	.Lwpush
	shll16	r3
.Lundo0:
	mov.l	@(48,r11),r1
	mov.l	r1,@(0,r11)
	mov.l	@(44,r11),r1
	mov.l	r1,@(48,r11)
	mov.l	@(40,r11),r1
	mov.l	r1,@(44,r11)
	mov.l	r7,@(40,r11)
.Ldecline0:
	mov.l	@r15+,r11
	mov.l	@r15+,r10
	mov.l	@r15+,r9
	mov.l	@r15+,r8
	rts
	mov	#1,r0
	.global	_recompsx_gte_rtp1
	.type	_recompsx_gte_rtp1,@function
_recompsx_gte_rtp1:
@block A
	mov.l	r8,@-r15		;; stack
	mov.l	r9,@-r15		;; stack
	mov.l	r10,@-r15		;; stack
	mov.l	r11,@-r15		;; stack
	mov	r5,r0
	tst	#1,r0
	bf	DECLINE			;; exit
	mov.l	.Lk2592,r0
	add	r6,r0
	mov	r4,r1
	clrmac
	mac.w	@r0+,@r1+
	mac.w	@r0+,@r1+
	mac.w	@r0+,@r1+
	sts	macl,r8
	mov	r4,r1
	clrmac
	mac.w	@r0+,@r1+
	mac.w	@r0+,@r1+
	mac.w	@r0+,@r1+
	sts	macl,r9
	mov	r4,r1
	clrmac
	mac.w	@r0+,@r1+
	mac.w	@r0+,@r1+
	mac.w	@r0+,@r1+
	sts	macl,r10
	! the vertex within +-2^14 (vx, vy, vz) and the translation narrow (TR_WIDE clear)
	mov.l	@r4,r2
	mov.l	@(4,r4),r3
	mov.l	.Lk3fff,r5
	mov.l	.Lkm4000,r7
	exts.w	r2,r4
	cmp/gt	r5,r4
	bt	DECLINE			;; exit
	cmp/ge	r7,r4
	bf	DECLINE			;; exit
	cmp/gt	r5,r3
	bt	DECLINE			;; exit
	cmp/ge	r7,r3
	bf	DECLINE			;; exit
	mov	r2,r3
	shll	r3
	xor	r2,r3
	cmp/pz	r3
	bf	DECLINE			;; exit
	mov.l	.Lk296,r0
	mov.l	@(r0,r6),r0		;; word=74
	tst	r0,r0
	bf	DECLINE			;; exit
	! MAC = TR + (row >> 12), and IR unsaturated: each its own 16-bit sign extension
	mov	r6,r11
	add	#64,r11
	mov	#-12,r5
	mov.l	@(36,r6),r1		;; word=9
	mov.l	@(40,r6),r2		;; word=10
	mov.l	@(44,r6),r3		;; word=11
	shad	r5,r8
	shad	r5,r9
	shad	r5,r10
	add	r1,r8
	add	r2,r9
	add	r3,r10
	exts.w	r8,r1
	cmp/eq	r8,r1
	bf	DECLINE			;; exit
	exts.w	r9,r2
	cmp/eq	r9,r2
	bf	DECLINE			;; exit
	exts.w	r10,r3
	cmp/eq	r10,r3
	bf	DECLINE			;; exit
	cmp/pz	r10
	bf	WNEG			;; exit use=r6,r8,r9,r10,r11
	mov.l	r8,@(4,r11)		;; word=17 free
	mov.l	r9,@(8,r11)		;; word=18 free
	mov.l	r10,@(12,r11)		;; word=19 free
	mov.l	r8,@(16,r11)		;; word=20 free
	mov.l	r9,@(20,r11)		;; word=21 free
	mov.l	r10,@(24,r11)		;; word=22 free
	! H / SZ3 the hardware's way (Gte.unrDivide); the divisor normalised by its leading zeros in
	! sixteen bits (Gte.countLeadingZeros16): its high byte's from the CLZ table (word 392), or
	! its low byte's and eight when the high one is zero
	mov.l	@(56,r6),r1		;; word=14
	extu.w	r1,r1
	mov	r10,r2
	add	r2,r2
	cmp/gt	r1,r2
	bf	WDIV			;; exit use=r6,r8,r9,r10,r11
	mov	r10,r0
	shlr8	r0
	tst	r0,r0
	movt	r5
	neg	r5,r3
	and	r10,r3
	or	r3,r0
	shll2	r0
	mov.l	.Lk1568,r3
	add	r6,r3
	mov.l	@(r0,r3),r3		;; table
	shll2	r5
	shll	r5
	add	r5,r3
	shld	r3,r1
	mov	r10,r2
	shld	r3,r2
	mov	r2,r0
	add	#64,r0
	mov	#-7,r5
	shld	r5,r0
	shll2	r0
	mov.l	.Lkm512,r3
	add	r6,r3
	mov.l	@(r0,r3),r3		;; table
	mov.l	.Lk101,r5
	add	r5,r3
	mov.l	@(40,r11),r7		;; word=26
	mov.l	@(44,r11),r4		;; word=27
	mov.l	r4,@(40,r11)		;; word=26 undo
	mov.l	@(48,r11),r4		;; word=28
	mov.l	r4,@(44,r11)		;; word=27 undo
	mov.l	@(0,r11),r4		;; word=16
	mov.l	r4,@(48,r11)		;; word=28 undo
	mov.l	r10,@(0,r11)		;; word=16 undo
	mul.l	r3,r2
	mov.l	.Lk2000080,r0
	sts	macl,r2
	sub	r2,r0
	mov	#-8,r5
	shad	r5,r0
	mul.l	r3,r0
	mov.l	.Lk80,r4
	sts	macl,r0
	add	r4,r0
	shad	r5,r0
	dmulu.l	r1,r0
	mov.l	.Lk8000,r2
	mov	#0,r3
	clrt
	sts	macl,r1
	addc	r2,r1
	sts	mach,r0
	addc	r3,r0
	xtrct	r0,r1
	mov.l	.LkFFFF,r2
	cmp/hi	r2,r1
	bt	WQ			;; exit use=r1,r6,r8,r9,r10,r11
	! SX2/SY2 and MAC0: OF + IR * q, and the depth cue DQB + DQA * q, each unless it overflows
	mul.l	r1,r8
	mov.l	@(48,r6),r2		;; word=12
	sts	macl,r8
	addv	r8,r2
	bt	DECLINE			;; exit
	mul.l	r1,r9
	mov.l	@(52,r6),r4		;; word=13
	sts	macl,r9
	addv	r9,r4
	bt	DECLINE			;; exit
	mov.l	@(60,r11),r3		;; word=31
	mul.l	r1,r3
	mov	#64,r0
	mov.l	@(r0,r11),r9		;; word=32
	sts	macl,r10
	addv	r10,r9
	bt	DECLINE			;; exit
	! the screen's -0x400..0x3FF for both coordinates: (sx + 2^26 | sy + 2^26) below 2^27
	mov.l	.Lk4000000,r5
	mov	r2,r1
	add	r5,r1
	mov	r4,r3
	add	r5,r3
	or	r3,r1
	mov.l	.Lk8000000,r5
	cmp/hs	r5,r1
	bt	.Lsat			;; last
@end
	mov	r4,r0
	shlr16	r0
	xtrct	r0,r2
	mov	#0,r3
.Ljoin_sat:
	mov	#-12,r5
	mov	r9,r1
	shad	r5,r1
	cmp/pz	r1
	bt	.Lir0pos
	mov.l	.Lk1000,r5
	mov	#0,r1
	or	r5,r3
.Ljoin_ir0:
@block B
	mov.l	@(32,r11),r4		;; word=24
	mov.l	r4,@(28,r11)		;; word=23
	mov.l	@(36,r11),r5		;; word=25
	mov.l	r5,@(32,r11)		;; word=24
	mov.l	r2,@(36,r11)		;; word=25
	mov.l	.Lk292,r0
	mov.l	@(r0,r6),r4		;; word=73
	shar	r4
	mov.l	r4,@(r0,r6)		;; word=73
	mov.l	r9,@(52,r11)		;; word=29
	mov.l	r1,@(56,r11)		;; word=30
	mov.l	@(60,r6),r4		;; word=15
	or	r3,r4
	mov.l	r4,@(60,r6)		;; word=15
	mov.l	@r15+,r11		;; stack
	mov.l	@r15+,r10		;; stack
	mov.l	@r15+,r9		;; stack
	mov	#0,r0
	rts				;; last
@end
	mov.l	@r15+,r8
.Lundo1:
	mov.l	@(48,r11),r1
	mov.l	r1,@(0,r11)
	mov.l	@(44,r11),r1
	mov.l	r1,@(48,r11)
	mov.l	@(40,r11),r1
	mov.l	r1,@(44,r11)
	mov.l	r7,@(40,r11)
.Ldecline1:
	mov.l	@r15+,r11
	mov.l	@r15+,r10
	mov.l	@r15+,r9
	mov.l	@r15+,r8
	rts
	mov	#1,r0
.Lir0pos:
	! MAC0 >> 12 not negative: above 0x1000 it saturates, with F_IR0
	mov.l	.Lk1000,r5
	cmp/gt	r5,r1
	bf	.Ljoin_ir0
	mov	r5,r1
	bra	.Ljoin_ir0
	or	r5,r3
.Lsat:
	! one coordinate or both off the screen's -0x400..0x3FF: each clamped, F_SX2 / F_SY2 raised
	mov	#0,r3
	mov	#-4,r1
	shll8	r1
	not	r1,r5
	mov	r2,r0
	shlr16	r0
	exts.w	r0,r0
	cmp/ge	r1,r0
	bt	.Lxnotlo
	mov	r1,r0
	mov	#64,r7
	shll8	r7
	bra	.Lxdone
	or	r7,r3
.Lxnotlo:
	cmp/gt	r5,r0
	bf	.Lxdone
	mov	r5,r0
	mov	#64,r7
	shll8	r7
	or	r7,r3
.Lxdone:
	extu.w	r0,r8
	mov	r4,r0
	shlr16	r0
	exts.w	r0,r0
	cmp/ge	r1,r0
	bt	.Lynotlo
	mov	r1,r0
	mov	#32,r7
	shll8	r7
	bra	.Lydone
	or	r7,r3
.Lynotlo:
	cmp/gt	r5,r0
	bf	.Lydone
	mov	r5,r0
	mov	#32,r7
	shll8	r7
	or	r7,r3
.Lydone:
	shll16	r0
	or	r0,r8
	bra	.Ljoin_sat
	mov	r8,r2
.Lwq1:
	! the quotient above 16 bits, at most 0x1FFFF (Gte.unrQuotient's clamp); the SZ push is done
	mov	#2,r2
	shll16	r2
	cmp/hs	r2,r1
	bf	.Lwqn
	mov	r2,r1
	add	#-1,r1
.Lwqn:
	mov	#0,r3
.Lwide:
	! r1 n (0x10000..0x1FFFF), r3 the flags so far, r8-r10 MAC1-3, the SZ push done. MAC1-3 and
	! IR1-3 again (the block's stores may not have run before its exit); then SX2 and SY2 as
	! Gte.screenWide: OF + IR * n in 64 bits, MAC0's flags from it (0x8000 << positive), its
	! bits 16-47 saturated to -0x400..0x3FF with F_SX2 / F_SY2
	mov.l	r8,@(4,r11)
	mov.l	r9,@(8,r11)
	mov.l	r10,@(12,r11)
	mov.l	r8,@(16,r11)
	mov.l	r9,@(20,r11)
	mov.l	r10,@(24,r11)
	dmuls.l	r8,r1
	mov.l	@(48,r6),r2
	mov	r2,r0
	shll	r0
	subc	r0,r0
	sts	macl,r4
	sts	mach,r5
	clrt
	addc	r2,r4
	addc	r0,r5
	mov	r4,r0
	shll	r0
	subc	r0,r0
	cmp/eq	r0,r5
	bt	.Lwx
	cmp/pz	r5
	movt	r0
	mov.l	.Lk8000,r2
	shld	r0,r2
	or	r2,r3
.Lwx:
	xtrct	r5,r4
	mov	#-4,r2
	shll8	r2
	cmp/ge	r2,r4
	bt	.Lwxlo
	mov	r2,r4
	mov	#64,r0
	shll8	r0
	bra	.Lwxd
	or	r0,r3
.Lwxlo:
	not	r2,r2
	cmp/gt	r2,r4
	bf	.Lwxd
	mov	r2,r4
	mov	#64,r0
	shll8	r0
	or	r0,r3
.Lwxd:
	extu.w	r4,r7
	dmuls.l	r9,r1
	mov.l	@(52,r6),r2
	mov	r2,r0
	shll	r0
	subc	r0,r0
	sts	macl,r4
	sts	mach,r5
	clrt
	addc	r2,r4
	addc	r0,r5
	mov	r4,r9
	mov	r4,r0
	shll	r0
	subc	r0,r0
	cmp/eq	r0,r5
	bt	.Lwy
	cmp/pz	r5
	movt	r0
	mov.l	.Lk8000,r2
	shld	r0,r2
	or	r2,r3
.Lwy:
	xtrct	r5,r4
	mov	#-4,r2
	shll8	r2
	cmp/ge	r2,r4
	bt	.Lwylo
	mov	r2,r4
	mov	#32,r0
	shll8	r0
	bra	.Lwyd
	or	r0,r3
.Lwylo:
	not	r2,r2
	cmp/gt	r2,r4
	bf	.Lwyd
	mov	r2,r4
	mov	#32,r0
	shll8	r0
	or	r0,r3
.Lwyd:
	shll16	r4
	or	r4,r7
	! the depth cue as Gte.depthCueWide: MAC0 = DQB + DQA * n in 64 bits, its flags; IR0 at
	! .Ljoin_sat
	mov.l	@(60,r11),r2
	dmuls.l	r2,r1
	mov	#64,r0
	mov.l	@(r0,r11),r2
	mov	r2,r0
	shll	r0
	subc	r0,r0
	sts	macl,r9
	sts	mach,r5
	clrt
	addc	r2,r9
	addc	r0,r5
	mov	r9,r0
	shll	r0
	subc	r0,r0
	cmp/eq	r0,r5
	bt	.Lwdq
	cmp/pz	r5
	movt	r0
	mov.l	.Lk8000,r2
	shld	r0,r2
	or	r2,r3
.Lwdq:
	bra	.Ljoin_sat
	mov	r7,r2
.Lwpush:
	! Gte.pushSz with r2: SZ0-2 are words 26-28, SZ3 word 16; then n = 0x1FFFF
	mov.l	@(44,r11),r0
	mov.l	r0,@(40,r11)
	mov.l	@(48,r11),r0
	mov.l	r0,@(44,r11)
	mov.l	@(0,r11),r0
	mov.l	r0,@(48,r11)
	mov.l	r2,@(0,r11)
	mov	#2,r1
	shll16	r1
	bra	.Lwide
	add	#-1,r1
	.align	2
.Lk2592:	.long	2592
.Lk3fff:	.long	0x3FFF
.Lkm4000:	.long	-0x4000
.Lk296:		.long	296
.Lkm512:	.long	-512
.Lk101:		.long	0x101
.Lk2000080:	.long	0x2000080
.Lk80:		.long	0x80
.Lk8000:	.long	0x8000
.LkFFFF:	.long	0xFFFF
.Lk4000000:	.long	0x4000000
.Lk8000000:	.long	0x8000000
.Lk292:		.long	292
.Lk1000:	.long	0x1000
.Lk1568:	.long	1568
	.size	_recompsx_gte_rtp1, .-_recompsx_gte_rtp1
	.popsection
