-		if(el.length == 0) {
-			return acc;
-		}
-
-		final head = el[0];
-		final tail = el.slice(1);
-		switch(head.expr) {
-			case TBinop(OpAssign, { expr: TLocal(v1) }, { expr: TLocal(v2) }) if(v1 == v2): {
-				return blockElement(acc, tail);
-			}
-			case TBinop(op, _, _) if(op.match(OpAssignOp(_)) || op == OpAssign): {
-				return blockElement([head].concat(acc), tail);
-			}
-			case TUnop(op, _, _) if(op == OpIncrement || op == OpDecrement): {
-				return blockElement([head].concat(acc), tail);
+		// recompsx: this walked the statement list by recursing once per element, so a block
+		// of N statements cost N stack frames and a large program exhausted the eval stack.
+		// Every recursive call was in tail position, so the recursion is a loop: the frames
+		// were carrying nothing the next iteration could not read from `acc` and `el`.
+		while(true) {
+			if(el.length == 0) {
+				return acc;
 			}
-			case TLocal(_): {
-				return blockElement(acc, tail);
-			}
-			case TField(_, fa) if(!PurityState.isPureFieldAccess(fa)): {
-				return blockElement([head].concat(acc), tail);
-			}
-			case TFunction(_), TConst(_), TTypeExpr(_): {
-				return blockElement(acc, tail);
-			}
-			case TMeta(meta, _) if(PurityState.getPurityFromMeta(meta) == Pure): {
-				return blockElement(acc, tail);
-			}
-			case TIf({ expr: TConst(TBool(t)) }, e1, e2): {
-				if(t) {
-					return blockElement(acc, [e1].concat(tail));
-				} else {
-					return switch(e2) {
-						case null: blockElement(acc, tail);
-						case e: blockElement(acc, [e.trustMe()].concat(tail));
+
+			final head = el[0];
+			final tail = el.slice(1);
+			switch(head.expr) {
+				case TBinop(OpAssign, { expr: TLocal(v1) }, { expr: TLocal(v2) }) if(v1 == v2): {
+					{ el = tail; continue; }
+				}
+				case TBinop(op, _, _) if(op.match(OpAssignOp(_)) || op == OpAssign): {
+					{ acc = [head].concat(acc); el = tail; continue; }
+				}
+				case TUnop(op, _, _) if(op == OpIncrement || op == OpDecrement): {
+					{ acc = [head].concat(acc); el = tail; continue; }
+				}
+				case TLocal(_): {
+					{ el = tail; continue; }
+				}
+				case TField(_, fa) if(!PurityState.isPureFieldAccess(fa)): {
+					{ acc = [head].concat(acc); el = tail; continue; }
+				}
+				case TFunction(_), TConst(_), TTypeExpr(_): {
+					{ el = tail; continue; }
+				}
+				case TMeta(meta, _) if(PurityState.getPurityFromMeta(meta) == Pure): {
+					{ el = tail; continue; }
+				}
+				case TIf({ expr: TConst(TBool(t)) }, e1, e2): {
+					if(t) {
+						{ el = [e1].concat(tail); continue; }
+					} else {
+						if(e2 == null) {
+							el = tail;
+						} else {
+							el = [e2.trustMe()].concat(tail);
+						}
+						continue;
 					}
 				}
-			}
-			case TSwitch(e, cases, edef): {
-				final opt = checkConstantSwitch({e: e, cases: cases, edef: edef});
-				if(opt != null) {
-					return blockElement(acc, [opt.trustMe()].concat(tail));
-				} else {
-					return blockElement([head].concat(acc), tail);
+				case TSwitch(e, cases, edef): {
+					final opt = checkConstantSwitch({e: e, cases: cases, edef: edef});
+					if(opt != null) {
+						{ el = [opt.trustMe()].concat(tail); continue; }
+					} else {
+						{ acc = [head].concat(acc); el = tail; continue; }
+					}
+				}
+				case TParenthesis(e1), TMeta(_, e1), TCast(e1, null), TField(e1, _), TUnop(_, _, e1), TEnumIndex(e1), TEnumParameter(e1, _, _): {
+					{ el = [e1].concat(tail); continue; }
+				}
+				case TArray(e1, e2), TBinop(_, e1, e2): {
+					{ el = [e1, e2].concat(tail); continue; }
+				}
+				case TArrayDecl(el1): {
+					{ el = el1.concat(tail); continue; }
+				}
+				case TCall({ expr: TField(_, FEnum(_)) }, el1): {
+					{ el = el1.concat(tail); continue; }
+				}
+				case TObjectDecl(fl): {
+					final values = [for(f in fl) f.expr];
+					{ el = values.concat(tail); continue; }
+				}
+				case TIf(e1, e2, null) if(!hasSideEffects(e2)): {
+					{ el = [e1].concat(tail); continue; }
+				}
+				case TIf(e1, e2, e3) 
+					if(e3 != null && !hasSideEffects(e2) && !hasSideEffects(e3)): {
+					{ el = [e1].concat(tail); continue; }
+				}
+				case TBlock([e1]): {
+					{ el = [e1].concat(tail); continue; }
+				}
+				case TBlock([]): {
+					{ el = tail; continue; }
+				}
+				case TBlock(el1): {
+					final r: Array<TypedExpr> = OptimizerTexpr.blockElement([], el1);
+					r.reverse();
+					{ el = r.concat(tail); continue; }
+				}
+				case TContinue: {
+					{ acc = []; el = tail; continue; }
+				}
+				case _: {
+					{ acc = [head].concat(acc); el = tail; continue; }
 				}
-			}
-			case TParenthesis(e1), TMeta(_, e1), TCast(e1, null), TField(e1, _), TUnop(_, _, e1), TEnumIndex(e1), TEnumParameter(e1, _, _): {
