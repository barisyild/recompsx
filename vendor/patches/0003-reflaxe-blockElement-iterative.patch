 .../RemovePureExpressionsImpl.hx              | 170 +++++++++---------
 1 file changed, 89 insertions(+), 81 deletions(-)

diff --git a/src/reflaxe/preprocessors/implementations/RemovePureExpressionsImpl.hx b/src/reflaxe/preprocessors/implementations/RemovePureExpressionsImpl.hx
index 5a49716..5a2e9ac 100644
--- a/src/reflaxe/preprocessors/implementations/RemovePureExpressionsImpl.hx
+++ b/src/reflaxe/preprocessors/implementations/RemovePureExpressionsImpl.hx
@@ -240,91 +240,99 @@ private class OptimizerTexpr {
 		is built in reverse order and must be reversed by the caller.
 	**/
